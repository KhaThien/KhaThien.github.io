---
interface Props {
  headers: string[];
  rows:    string[][];
  note?:   string;
}
const { headers, rows, note } = Astro.props;
---

<div class="matrix-wrap" style="margin-top:0.5rem">
  <table class="decision-matrix">
    <thead>
      <tr>{headers.map(h => <th>{h}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr>{row.map(cell => <td set:html={cell} />)}</tr>
      ))}
    </tbody>
  </table>
</div>
{note && <p style="font-size:0.85rem;color:var(--muted);margin-top:0.5rem">{note}</p>}
