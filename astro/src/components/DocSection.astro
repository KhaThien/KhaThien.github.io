---
interface Doc {
  title: string;
  desc:  string;
  src?:  string;
}
interface Props {
  intro: string;
  docs:  Doc[];
}
const { intro, docs } = Astro.props;
---

<div class="doc-section">
  <p class="doc-intro">{intro}</p>
  <div class="doc-grid">
    {docs.map(d => (
      d.src
        ? <button class="doc-card" data-src={d.src} type="button">
            <span class="doc-title">{d.title}</span>
            <span class="doc-desc">{d.desc}</span>
            <span class="doc-view">View file</span>
          </button>
        : <div class="doc-card doc-card--soon">
            <span class="doc-title">{d.title}</span>
            <span class="doc-desc">{d.desc}</span>
            <span class="doc-soon-label">Coming soon</span>
          </div>
    ))}
  </div>
</div>

<div class="doc-lightbox" id="doc-lightbox">
  <button class="doc-lightbox-close" id="doc-lightbox-close" aria-label="Close">&times;</button>
  <div class="doc-lightbox-inner" id="doc-lightbox-inner"></div>
</div>

<script>
const lb      = document.getElementById('doc-lightbox')!;
const inner   = document.getElementById('doc-lightbox-inner')!;
const closeBtn = document.getElementById('doc-lightbox-close')!;

function openDoc(src: string) {
  inner.innerHTML = `<iframe src="${src}" title="Document" style="width:100%;height:100%;border:none;display:block;"></iframe>`;
  lb.classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeDoc() {
  lb.classList.remove('open');
  inner.innerHTML = '';
  document.body.style.overflow = '';
}

document.querySelectorAll<HTMLButtonElement>('.doc-card[data-src]').forEach(card => {
  card.addEventListener('click', () => openDoc(card.dataset.src!));
});
closeBtn.addEventListener('click', closeDoc);
lb.addEventListener('click', e => { if (e.target === lb) closeDoc(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDoc(); });
</script>

<style>
  .doc-section { margin: 2rem 0; }
  .doc-intro { margin-bottom: 1.25rem; color: var(--muted); font-size: 0.92rem; line-height: 1.7; }
  .doc-grid { display: flex; flex-wrap: wrap; gap: 1rem; }

  .doc-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.3rem;
    border: 1px solid rgba(0,0,0,0.3);
    border-radius: 6px;
    background: #ffffff;
    text-align: left;
    cursor: pointer;
    width: 220px;
    transition: box-shadow 0.15s, border-color 0.15s;
    font-family: inherit;
    color: inherit;
  }
  .doc-card[data-src]:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.08); border-color: #aaa; }
  .doc-card--soon { cursor: default; opacity: 0.55; }

  .doc-title { font-size: 0.88rem; font-weight: 600; line-height: 1.3; }
  .doc-desc  { font-size: 0.78rem; color: var(--muted); line-height: 1.4; }
  .doc-view  { font-size: 0.75rem; font-weight: 600; color: var(--muted); margin-top: auto; text-decoration: underline; text-align: right; }
  .doc-soon-label { font-size: 0.72rem; font-style: italic; color: var(--muted); margin-top: 0.25rem; }

  /* Lightbox */
  .doc-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.75);
    z-index: 999;
    align-items: center;
    justify-content: center;
  }
  .doc-lightbox.open { display: flex; }
  .doc-lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    line-height: 1;
  }
  .doc-lightbox-inner {
    width: min(90vw, 960px);
    height: 85vh;
    background: #fff;
    border-radius: 4px;
    overflow: hidden;
  }
  .doc-lightbox-inner iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
