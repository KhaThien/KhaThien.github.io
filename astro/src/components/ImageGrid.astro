---
interface Image {
  src:    string;
  alt:    string;
  style?: string;
}
interface Props {
  images: Image[];
  cols?:  number;
}
const { images, cols } = Astro.props;
const gridStyle = cols ? `grid-template-columns:repeat(${cols},1fr)` : '';
---

<div class="concept-grid" style={gridStyle}>
  {images.map(img => (
    <img class="concept-img" src={img.src} alt={img.alt} style={img.style} />
  ))}
</div>
